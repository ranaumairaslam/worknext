		{
			"name": "01. Auth",
			"item": [
				{
					"name": "Login (Unified Route)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"if (response.success && response.token) {",
									"    pm.globals.set(\"jwt_token\", response.token);",
									"    console.log(\"Saved JWT token to globals:\", response.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"superadmin@example.com\",\n    \"password\": \"superadmin123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Unified authentication. Retrieves role and redirects user to their unique dashboard."
					},
					"response": []
				},
